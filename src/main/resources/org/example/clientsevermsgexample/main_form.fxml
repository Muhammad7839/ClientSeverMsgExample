<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.clientsevermsgexample.MainController"
            prefWidth="600.0" prefHeight="430.0"
            style="-fx-background-color: #f0f4f8;">

    <top>
        <VBox spacing="10" style="-fx-padding: 15 20 10 20;">
            <Label text="Farmingdale Network Utility"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Server"/>
                <TextField fx:id="urlName" prefWidth="300"/>
                <Label text="Port"/>
                <ComboBox fx:id="dropdownPort" prefWidth="100"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 10 20;">
            <TextArea fx:id="resultArea" prefHeight="120" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="testBtn" text="Test Port" onAction="#checkConnection"/>
                <Button fx:id="clearBtn" text="Clear" onAction="#clearBtn"/>
            </HBox>

            <TitledPane text="Client/Server Panel" expanded="true">
                <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10;">
                    <Button fx:id="testBtn1" text="Start Server" onAction="#startServer"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                    <Button fx:id="clearBtn1" text="Start Client" onAction="#startClient"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                </HBox>
            </TitledPane>

            <TitledPane text="Chat Window" expanded="true">
                <HBox spacing="20" alignment="CENTER" style="-fx-padding: 10;">
                    <Button fx:id="user2_server" text="User 2 (Server)"
                            style="-fx-background-color: #3F51B5; -fx-text-fill: white;"/>
                    <Button fx:id="user1_client" text="User 1 (Client)"
                            style="-fx-background-color: #009688; -fx-text-fill: white;"/>
                </HBox>
            </TitledPane>
        </VBox>
    </center>
</BorderPane>
