<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.clientsevermsgexample.ServerView"
            prefWidth="550" prefHeight="420"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 15 20 10 20;">
            <Label text="🔵 Farmingdale Messenger - Server"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fx:id="sp_main" fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox fx:id="vbox_messages" spacing="10" style="-fx-padding: 20;" prefWidth="500"/>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 20 20 20;">
            <TextField fx:id="tf_message" promptText="Type a message..." HBox.hgrow="ALWAYS"
                       style="-fx-font-size: 14px;"/>
            <Button fx:id="button_send" text="Send"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 6 15;"/>
        </HBox>
    </bottom>
</BorderPane>
